{
  "protocol_version": "2.0",
  "plugin": {
    "id": "video.hanime1",
    "name": "Hanime1",
    "version": "0.2.0",
    "entrypoint": "./ultimate_provider.py:Hanime1Provider",
    "config_key": "hanime1"
  },
  "media_types": ["video"],
  "identity": {
    "content_type": "video",
    "host_id_prefix": "HN1",
    "platform_label": "Hanime1",
    "aliases": ["hanime1", "hn1"]
  },
  "presentation": {
    "media_card": {
      "cover": {
        "aspect_ratio": "16 / 9",
        "mobile_aspect_ratio": "16 / 9",
        "fit": "cover"
      },
      "badge": {
        "show_platform_label": true,
        "label": "Hanime1"
      }
    }
  },
  "capabilities": [
    { "key": "catalog.search" },
    { "key": "catalog.detail" },
    { "key": "playback.proxy.url" },
    { "key": "playback.proxy.stream" },
    { "key": "playback.sources.build" },
    { "key": "transport.http.request" },
    { "key": "health.query.status" }
  ],
  "configuration": {
    "order": 45,
    "label": "Hanime1",
    "credential": {
      "enabled_field": "enabled",
      "required_fields": ["domain"],
      "disabled_message": "Hanime1 未启用，不能使用该平台查询。",
      "unconfigured_message": "Hanime1 站点域名未配置，不能使用该平台查询。"
    },
    "sections": [
      {
        "id": "basic",
        "label": "基础配置",
        "fields": [
          { "key": "enabled", "label": "启用", "type": "boolean" },
          { "key": "domain", "label": "站点域名", "type": "text", "placeholder": "https://hanime1.me" },
          { "key": "user_agent", "label": "User-Agent", "type": "text", "placeholder": "留空使用内置桌面浏览器标识" },
          { "key": "timeout_seconds", "label": "请求超时秒数", "type": "number", "placeholder": "30" },
          { "key": "proxy", "label": "HTTP 代理", "type": "text", "placeholder": "http://127.0.0.1:7890" }
        ]
      }
    ]
  },
  "resource_policy": {
    "assets": {
      "image": {
        "available": true,
        "download_enabled": true,
        "request_profiles": [
          {
            "match_hosts": ["vdownload.hembed.com", "vdownload-7.hembed.com", "hanime1.me"],
            "referer": "https://hanime1.me/",
            "proxy_mode": "frontend",
            "frontend_proxy": true
          }
        ]
      },
      "cover": {
        "available": true,
        "download_enabled": true,
        "request_profiles": [
          {
            "match_hosts": ["vdownload.hembed.com", "vdownload-7.hembed.com", "hanime1.me"],
            "referer": "https://hanime1.me/",
            "proxy_mode": "frontend",
            "frontend_proxy": true
          }
        ]
      }
    }
  },
  "packaging": {
    "android": {
      "enabled": true,
      "pip_options": ["--no-deps"],
      "pip_install_args": [],
      "pip_requirements": ["requests", "beautifulsoup4", "lxml"]
    },
    "external": {
      "pip_requirements": ["requests", "beautifulsoup4", "lxml"]
    },
    "pyinstaller": {
      "pip_requirements": ["requests", "beautifulsoup4", "lxml"]
    }
  }
}
